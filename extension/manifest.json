{
  "manifest_version": 3,
  "name": "CVAT Sidebar Shortcuts",
  "version": "2.9.0",
  "description": "CVAT 도구 단축키, 라벨 선택창, 라벨 찾기·누락 검수, 붙여넣기 반복, 연결 상태 확인과 한글 가이드를 제공합니다.",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_permissions": ["webRequest"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "health-worker.js"},
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CVAT Sidebar Shortcuts",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
