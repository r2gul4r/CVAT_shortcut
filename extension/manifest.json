{
  "manifest_version": 3,
  "name": "CVAT Sidebar Shortcuts",
  "version": "2.2.1",
  "description": "CVAT 라벨 선택 오버레이, N 이전 도구의 라벨 연동, AI·브러쉬·폴리곤 단축키, Space 화면 이동, 크기·투명도 조절과 한글 가이드를 제공합니다.",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CVAT Sidebar Shortcuts",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
