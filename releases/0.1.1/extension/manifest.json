{
  "manifest_version": 3,
  "name": "CVAT Sidebar Shortcuts",
  "version": "0.1.1",
  "description": "Choose CVAT AI/Brush shortcuts, an exact default label, and active mask brush wheel sizing.",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "action": {
    "default_title": "CVAT Sidebar Shortcuts",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
